# Copy to .env and export the variables in your shell, or set them in the process environment.
# The application reads AGENT_HARNESS_* variables. It never reads a hidden default API key.

AGENT_HARNESS_MODEL_PROVIDER=mock
AGENT_HARNESS_OPENAI_API_KEY=
AGENT_HARNESS_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_HARNESS_OPENAI_MODEL=gpt-4o-mini
AGENT_HARNESS_OPENAI_TIMEOUT_SECONDS=30
AGENT_HARNESS_DATABASE_PATH=./data/harness.db
AGENT_HARNESS_MAX_STEPS=8
AGENT_HARNESS_TOOL_TIMEOUT_SECONDS=5
AGENT_HARNESS_MAX_RETRIES=2
AGENT_HARNESS_MAX_INPUT_CHARS=8000
AGENT_HARNESS_MAX_CONTEXT_CHARS=12000
AGENT_HARNESS_MAX_OUTPUT_CHARS=8000
AGENT_HARNESS_LOG_LEVEL=INFO
# console prints OpenTelemetry spans locally. none disables span export.
AGENT_HARNESS_OTEL_EXPORTER=console
AGENT_HARNESS_ENABLE_MCP=true
AGENT_HARNESS_ALLOWED_TOOLS=calculator,current_utc_time,text_statistics,store_memory,recall_memory
AGENT_HARNESS_APPROVAL_TOOLS=delete_memory
AGENT_HARNESS_HOST=127.0.0.1
AGENT_HARNESS_PORT=8000
